# UI pratinjau tidak membutuhkan credential. Lihat docs/DATABASE_SETUP.md.
# Salin ke .env.local untuk development, jangan menimpa file yang sudah ada.
# Jangan commit .env.local dan jangan menambahkan NEXT_PUBLIC_ ke secret.

# Browser-safe Supabase Auth configuration. See docs/AUTH_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Auth Admin credential; required only for self-service account deletion.
# Supabase legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=

# Server-only. Runtime role: minimum DML permissions on the app schema.
DATABASE_URL=
# Server-only. Migration role: DDL permissions; direct/session connection.
# Use schema=app and verified TLS; never a transaction pooler for migrations.
DIRECT_URL=
# Path to the project's CA downloaded from Supabase Database Settings.
# Example: certs/prod-supabase.cer (also needed by TLS integration tests).
DATABASE_SSL_ROOT_CERT=

# Isi di .env.test.local dengan database khusus test yang sudah dimigrasi.
TEST_DATABASE_URL=

# Used later to validate authentication callback URLs.
APP_URL=http://localhost:3000
