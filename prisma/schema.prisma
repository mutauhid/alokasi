generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum WorkspaceType {
  personal
  shared

  @@schema("app")
}

enum MemberRole {
  owner
  editor
  viewer

  @@schema("app")
}

enum MemberStatus {
  active
  revoked

  @@schema("app")
}

enum TransactionType {
  income
  expense
  transfer

  @@schema("app")
}

enum AccountType {
  bank
  cash
  ewallet

  @@schema("app")
}

enum ReceiptDraftStatus {
  needs_review
  submitted
  cancelled

  @@schema("app")
}

enum ReconciliationResolution {
  matched
  adjusted

  @@schema("app")
}

enum DebtKind {
  debt
  receivable

  @@schema("app")
}

enum DebtOrigin {
  current
  historical

  @@schema("app")
}

enum TelegramDraftStatus {
  pending
  confirmed
  cancelled

  @@schema("app")
}

enum TelegramBudgetAlertStatus {
  pending
  sending
  sent
  failed

  @@schema("app")
}

enum WebPushNotificationType {
  budget_alert
  weekly_summary
  recurring_reminder
  low_balance
  stale_draft
  shared_activity
  debt_due

  @@schema("app")
}

enum WebPushDeliveryStatus {
  pending
  sending
  sent
  failed

  @@schema("app")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  authSubject          String?               @unique @map("auth_subject") @db.Uuid
  email                String?               @db.VarChar(320)
  displayName          String?               @map("display_name") @db.VarChar(100)
  disabledAt           DateTime?             @map("disabled_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  personalWorkspace    Workspace?
  telegramConnections  TelegramConnection[]
  webPushSubscriptions WebPushSubscription[]

  @@map("users")
  @@schema("app")
}

model Workspace {
  id                              String                         @id @default(uuid()) @db.Uuid
  name                            String                         @db.VarChar(100)
  type                            WorkspaceType
  personalOwnerId                 String?                        @unique @map("personal_owner_id") @db.Uuid
  personalOwner                   User?                          @relation(fields: [personalOwnerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currency                        String                         @default("IDR") @db.VarChar(3)
  timezone                        String                         @default("Asia/Jakarta") @db.VarChar(64)
  version                         Int                            @default(1)
  ownershipTransferToMembershipId String?                        @map("ownership_transfer_to_membership_id") @db.Uuid
  ownershipTransferRequestedAt    DateTime?                      @map("ownership_transfer_requested_at") @db.Timestamptz(3)
  ownershipTransferExpiresAt      DateTime?                      @map("ownership_transfer_expires_at") @db.Timestamptz(3)
  createdAt                       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                     Membership[]
  invitations                     Invitation[]
  accounts                        FinancialAccount[]
  categories                      Category[]
  periods                         BudgetPeriod[]
  cycleSettings                   CycleSetting[]
  auditEvents                     AuditEvent[]
  receiptDrafts                   ReceiptDraft[]
  recurringTransactionTemplates   RecurringTransactionTemplate[]
  balanceReconciliations          BalanceReconciliation[]
  telegramConnections             TelegramConnection[]
  telegramBudgetAlerts            TelegramBudgetAlert[]
  telegramRecurringReminders      TelegramRecurringReminder[]
  personalCategoryRules           PersonalCategoryRule[]
  webPushPreferences              WebPushPreference[]
  webPushDeliveries               WebPushDelivery[]
  webPushLowBalanceStates         WebPushLowBalanceState[]
  debtRecords                     DebtRecord[]
  debtPayments                    DebtPayment[]

  @@map("workspaces")
  @@schema("app")
}

model CycleSetting {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  startDay      Int            @map("start_day") @db.SmallInt
  effectiveDate DateTime       @map("effective_date") @db.Date
  version       Int
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  periods       BudgetPeriod[]

  @@unique([workspaceId, version])
  @@map("cycle_settings")
  @@schema("app")
}

model Membership {
  id                        String                         @id @default(uuid()) @db.Uuid
  workspaceId               String                         @map("workspace_id") @db.Uuid
  userId                    String                         @map("user_id") @db.Uuid
  role                      MemberRole
  status                    MemberStatus                   @default(active)
  version                   Int                            @default(1)
  joinedAt                  DateTime                       @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt                 DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  shortcutTokenHash         String?                        @unique @map("shortcut_token_hash") @db.VarChar(64)
  shortcutTokenCreatedAt    DateTime?                      @map("shortcut_token_created_at") @db.Timestamptz(3)
  shortcutTokenExpiresAt    DateTime?                      @map("shortcut_token_expires_at") @db.Timestamptz(3)
  shortcutTokenLastUsedAt   DateTime?                      @map("shortcut_token_last_used_at") @db.Timestamptz(3)
  shortcutDefaultAccountId  String?                        @map("shortcut_default_account_id") @db.Uuid
  shortcutDefaultCategoryId String?                        @map("shortcut_default_category_id") @db.Uuid
  workspace                 Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdTransactions       Transaction[]                  @relation("TransactionCreator")
  updatedTransactions       Transaction[]                  @relation("TransactionUpdater")
  invitations               Invitation[]                   @relation("InvitationCreator")
  receiptDrafts             ReceiptDraft[]                 @relation("ReceiptDraftCreator")
  recurringTemplates        RecurringTransactionTemplate[] @relation("RecurringTemplateCreator")
  reconciliations           BalanceReconciliation[]        @relation("ReconciliationCreator")
  telegramConnection        TelegramConnection?
  personalCategoryRules     PersonalCategoryRule[]
  webPushPreference         WebPushPreference?
  webPushDeliveries         WebPushDelivery[]
  webPushLowBalanceStates   WebPushLowBalanceState[]
  createdDebtRecords        DebtRecord[]                   @relation("DebtRecordCreator")
  createdDebtPayments       DebtPayment[]                  @relation("DebtPaymentCreator")

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId, status])
  @@map("memberships")
  @@schema("app")
}

model WebPushSubscription {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  endpointHash String            @unique @map("endpoint_hash") @db.VarChar(64)
  endpoint     String            @db.Text
  p256dh       String            @db.VarChar(180)
  auth         String            @db.VarChar(64)
  userAgent    String?           @map("user_agent") @db.VarChar(300)
  revokedAt    DateTime?         @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt   DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries   WebPushDelivery[]

  @@unique([userId, id])
  @@index([userId, revokedAt])
  @@map("web_push_subscriptions")
  @@schema("app")
}

model WebPushPreference {
  id                        String     @id @default(uuid()) @db.Uuid
  workspaceId               String     @map("workspace_id") @db.Uuid
  userId                    String     @map("user_id") @db.Uuid
  budgetAlertsEnabled       Boolean    @default(true) @map("budget_alerts_enabled")
  weeklySummaryEnabled      Boolean    @default(true) @map("weekly_summary_enabled")
  recurringRemindersEnabled Boolean    @default(true) @map("recurring_reminders_enabled")
  lowBalanceEnabled         Boolean    @default(false) @map("low_balance_enabled")
  lowBalanceThreshold       BigInt?    @map("low_balance_threshold")
  staleDraftsEnabled        Boolean    @default(true) @map("stale_drafts_enabled")
  sharedActivityEnabled     Boolean    @default(true) @map("shared_activity_enabled")
  debtDueRemindersEnabled   Boolean    @default(true) @map("debt_due_reminders_enabled")
  quietHoursStart           Int?       @map("quiet_hours_start") @db.SmallInt
  quietHoursEnd             Int?       @map("quiet_hours_end") @db.SmallInt
  hideSensitiveContent      Boolean    @default(true) @map("hide_sensitive_content")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                 Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership                Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, userId])
  @@map("web_push_preferences")
  @@schema("app")
}

model WebPushDelivery {
  id             String                  @id @default(uuid()) @db.Uuid
  workspaceId    String                  @map("workspace_id") @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  subscriptionId String                  @map("subscription_id") @db.Uuid
  type           WebPushNotificationType
  dedupeKey      String                  @map("dedupe_key") @db.VarChar(220)
  title          String                  @db.VarChar(120)
  body           String                  @db.VarChar(300)
  url            String                  @db.VarChar(500)
  tag            String                  @db.VarChar(120)
  status         WebPushDeliveryStatus   @default(pending)
  availableAt    DateTime                @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptedAt    DateTime?               @map("attempted_at") @db.Timestamptz(3)
  sentAt         DateTime?               @map("sent_at") @db.Timestamptz(3)
  failureCode    String?                 @map("failure_code") @db.VarChar(40)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership     Membership              @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  subscription   WebPushSubscription     @relation(fields: [userId, subscriptionId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([subscriptionId, dedupeKey])
  @@index([status, availableAt, createdAt])
  @@index([workspaceId, userId, type])
  @@map("web_push_deliveries")
  @@schema("app")
}

model WebPushLowBalanceState {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  isBelow        Boolean          @default(false) @map("is_below")
  lastNotifiedAt DateTime?        @map("last_notified_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership     Membership       @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  account        FinancialAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, userId, accountId])
  @@index([workspaceId, accountId])
  @@map("web_push_low_balance_states")
  @@schema("app")
}

model Invitation {
  id           String     @id @default(uuid()) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  createdBy    String     @map("created_by") @db.Uuid
  invitedEmail String     @map("invited_email") @db.VarChar(320)
  role         MemberRole
  tokenHash    String     @unique @map("token_hash") @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator      Membership @relation("InvitationCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, invitedEmail])
  @@map("invitations")
  @@schema("app")
}

model TelegramConnection {
  id                        String                      @id @default(uuid()) @db.Uuid
  workspaceId               String                      @map("workspace_id") @db.Uuid
  userId                    String                      @map("user_id") @db.Uuid
  telegramUserId            String?                     @unique @map("telegram_user_id") @db.VarChar(32)
  telegramChatId            String?                     @map("telegram_chat_id") @db.VarChar(32)
  linkCodeHash              String?                     @unique @map("link_code_hash") @db.VarChar(64)
  linkExpiresAt             DateTime?                   @map("link_expires_at") @db.Timestamptz(3)
  defaultAccountId          String                      @map("default_account_id") @db.Uuid
  defaultCategoryId         String                      @map("default_category_id") @db.Uuid
  defaultIncomeCategoryId   String?                     @map("default_income_category_id") @db.Uuid
  linkedAt                  DateTime?                   @map("linked_at") @db.Timestamptz(3)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace                 Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership                Membership                  @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  drafts                    TelegramDraft[]
  budgetAlerts              TelegramBudgetAlert[]
  budgetAlertsEnabled       Boolean                     @default(false) @map("budget_alerts_enabled")
  recurringReminders        TelegramRecurringReminder[]
  recurringRemindersEnabled Boolean                     @default(false) @map("recurring_reminders_enabled")
  weeklySummaryEnabled      Boolean                     @default(false) @map("weekly_summary_enabled")
  weeklySummaryClaimedWeek  DateTime?                   @map("weekly_summary_claimed_week") @db.Date
  weeklySummarySentAt       DateTime?                   @map("weekly_summary_sent_at") @db.Timestamptz(3)

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
  @@map("telegram_connections")
  @@schema("app")
}

model TelegramDraft {
  id                  String              @id @default(uuid()) @db.Uuid
  connectionId        String              @map("connection_id") @db.Uuid
  sourceMessageId     BigInt              @map("source_message_id")
  editPromptMessageId BigInt?             @map("edit_prompt_message_id")
  status              TelegramDraftStatus @default(pending)
  type                TransactionType     @default(expense)
  title               String              @db.VarChar(100)
  amount              BigInt
  note                String?             @db.VarChar(1000)
  transactionDate     DateTime            @map("transaction_date") @db.Date
  accountId           String              @map("account_id") @db.Uuid
  categoryId          String              @map("category_id") @db.Uuid
  transactionId       String?             @map("transaction_id") @db.Uuid
  expiresAt           DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  connection          TelegramConnection  @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([connectionId, sourceMessageId])
  @@index([connectionId, status, expiresAt])
  @@map("telegram_drafts")
  @@schema("app")
}

model TelegramBudgetAlert {
  id           String                    @id @default(uuid()) @db.Uuid
  workspaceId  String                    @map("workspace_id") @db.Uuid
  connectionId String                    @map("connection_id") @db.Uuid
  budgetId     String                    @map("budget_id") @db.Uuid
  threshold    Int                       @db.SmallInt
  actualAmount BigInt                    @map("actual_amount")
  limitAmount  BigInt                    @map("limit_amount")
  status       TelegramBudgetAlertStatus @default(pending)
  attemptedAt  DateTime?                 @map("attempted_at") @db.Timestamptz(3)
  sentAt       DateTime?                 @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   TelegramConnection        @relation(fields: [workspaceId, connectionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  budget       Budget                    @relation(fields: [workspaceId, budgetId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([connectionId, budgetId, threshold])
  @@index([connectionId, status, createdAt])
  @@index([workspaceId, budgetId])
  @@map("telegram_budget_alerts")
  @@schema("app")
}

model TelegramRecurringReminder {
  id           String                       @id @default(uuid()) @db.Uuid
  workspaceId  String                       @map("workspace_id") @db.Uuid
  connectionId String                       @map("connection_id") @db.Uuid
  templateId   String                       @map("template_id") @db.Uuid
  dueDate      DateTime                     @map("due_date") @db.Date
  status       TelegramBudgetAlertStatus    @default(pending)
  attemptedAt  DateTime?                    @map("attempted_at") @db.Timestamptz(3)
  sentAt       DateTime?                    @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  connection   TelegramConnection           @relation(fields: [workspaceId, connectionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  template     RecurringTransactionTemplate @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([connectionId, templateId, dueDate])
  @@index([connectionId, status, createdAt])
  @@index([workspaceId, templateId])
  @@map("telegram_recurring_reminders")
  @@schema("app")
}

model PersonalCategoryRule {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  keyword     String          @db.VarChar(60)
  keywordKey  String          @map("keyword_key") @db.VarChar(100)
  categoryId  String          @map("category_id") @db.Uuid
  type        TransactionType @default(expense)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership  Membership      @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  category    Category        @relation(fields: [workspaceId, categoryId, type], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, userId, keywordKey])
  @@index([workspaceId, userId])
  @@index([workspaceId, categoryId])
  @@map("personal_category_rules")
  @@schema("app")
}

model FinancialAccount {
  id                      String                         @id @default(uuid()) @db.Uuid
  workspaceId             String                         @map("workspace_id") @db.Uuid
  name                    String                         @db.VarChar(100)
  type                    AccountType
  openingBalance          BigInt                         @map("opening_balance")
  openingDate             DateTime                       @map("opening_date") @db.Date
  archivedAt              DateTime?                      @map("archived_at") @db.Timestamptz(3)
  version                 Int                            @default(1)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outgoing                Transaction[]                  @relation("SourceAccount")
  incoming                Transaction[]                  @relation("DestinationAccount")
  receiptDrafts           ReceiptDraft[]                 @relation("ReceiptDraftAccount")
  recurringTemplates      RecurringTransactionTemplate[]
  reconciliations         BalanceReconciliation[]
  webPushLowBalanceStates WebPushLowBalanceState[]
  debtRecords             DebtRecord[]
  debtPayments            DebtPayment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt])
  @@map("financial_accounts")
  @@schema("app")
}

// Utang/piutang memakai ledger terpisah dari transaksi arus kas. Pokok dan
// pembayaran memengaruhi saldo akun, tetapi tidak menjadi pemasukan,
// pengeluaran, realisasi budget, atau laporan arus kas.
model DebtRecord {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  createdBy       String            @map("created_by") @db.Uuid
  kind            DebtKind
  origin          DebtOrigin
  counterparty    String            @db.VarChar(100)
  title           String            @db.VarChar(100)
  principalAmount BigInt            @map("principal_amount")
  startDate       DateTime          @map("start_date") @db.Date
  dueDate         DateTime?         @map("due_date") @db.Date
  accountId       String?           @map("account_id") @db.Uuid
  note            String?           @db.VarChar(1000)
  idempotencyKey  String            @map("idempotency_key") @db.VarChar(128)
  requestHash     String            @map("request_hash") @db.VarChar(64)
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         Membership        @relation("DebtRecordCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  account         FinancialAccount? @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  payments        DebtPayment[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, createdBy, idempotencyKey])
  @@index([workspaceId, kind, dueDate])
  @@index([workspaceId, accountId, startDate])
  @@map("debt_records")
  @@schema("app")
}

model DebtPayment {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  debtRecordId   String           @map("debt_record_id") @db.Uuid
  createdBy      String           @map("created_by") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  amount         BigInt
  paymentDate    DateTime         @map("payment_date") @db.Date
  note           String?          @db.VarChar(500)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  requestHash    String           @map("request_hash") @db.VarChar(64)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  debtRecord     DebtRecord       @relation(fields: [workspaceId, debtRecordId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creator        Membership       @relation("DebtPaymentCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  account        FinancialAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, createdBy, idempotencyKey])
  @@index([workspaceId, debtRecordId, paymentDate, createdAt])
  @@index([workspaceId, accountId, paymentDate])
  @@map("debt_payments")
  @@schema("app")
}

// A completed reconciliation is an immutable balance snapshot. Only an
// explicitly confirmed adjustment affects account balance; it never becomes
// income, expense, transfer, or budget realization.
model BalanceReconciliation {
  id                 String                   @id @default(uuid()) @db.Uuid
  workspaceId        String                   @map("workspace_id") @db.Uuid
  accountId          String                   @map("account_id") @db.Uuid
  createdBy          String                   @map("created_by") @db.Uuid
  reconciliationDate DateTime                 @map("reconciliation_date") @db.Date
  recordedBalance    BigInt                   @map("recorded_balance")
  actualBalance      BigInt                   @map("actual_balance")
  difference         BigInt
  adjustmentAmount   BigInt                   @default(0) @map("adjustment_amount")
  resolution         ReconciliationResolution
  note               String?                  @db.VarChar(500)
  idempotencyKey     String                   @map("idempotency_key") @db.VarChar(128)
  requestHash        String                   @map("request_hash") @db.VarChar(64)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account            FinancialAccount         @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creator            Membership               @relation("ReconciliationCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, createdBy, idempotencyKey])
  @@index([workspaceId, accountId, reconciliationDate, createdAt])
  @@map("balance_reconciliations")
  @@schema("app")
}

model Category {
  id                 String                         @id @default(uuid()) @db.Uuid
  workspaceId        String                         @map("workspace_id") @db.Uuid
  name               String                         @db.VarChar(50)
  nameKey            String                         @map("name_key") @db.VarChar(100)
  type               TransactionType
  archivedAt         DateTime?                      @map("archived_at") @db.Timestamptz(3)
  version            Int                            @default(1)
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions       Transaction[]
  budgets            Budget[]
  suggestedDrafts    ReceiptDraft[]                 @relation("ReceiptDraftSuggestedCategory")
  selectedDrafts     ReceiptDraft[]                 @relation("ReceiptDraftSelectedCategory")
  recurringTemplates RecurringTransactionTemplate[]
  personalRules      PersonalCategoryRule[]

  @@unique([workspaceId, id, type])
  @@unique([workspaceId, type, nameKey])
  @@map("categories")
  @@schema("app")
}

// A row represents a submitted transaction. ReceiptDraft stays financially inert until submit.
model Transaction {
  id                   String                        @id @default(uuid()) @db.Uuid
  workspaceId          String                        @map("workspace_id") @db.Uuid
  createdBy            String                        @map("created_by") @db.Uuid
  updatedBy            String                        @map("updated_by") @db.Uuid
  type                 TransactionType
  title                String                        @db.VarChar(100)
  amount               BigInt
  transactionDate      DateTime                      @map("transaction_date") @db.Date
  accountId            String                        @map("account_id") @db.Uuid
  destinationAccountId String?                       @map("destination_account_id") @db.Uuid
  categoryId           String?                       @map("category_id") @db.Uuid
  note                 String?                       @db.VarChar(1000)
  idempotencyKey       String                        @map("idempotency_key") @db.VarChar(128)
  requestHash          String                        @map("request_hash") @db.VarChar(64)
  version              Int                           @default(1)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                     @map("deleted_at") @db.Timestamptz(3)
  recurringTemplateId  String?                       @map("recurring_template_id") @db.Uuid
  recurringDueDate     DateTime?                     @map("recurring_due_date") @db.Date
  creator              Membership                    @relation("TransactionCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  updater              Membership                    @relation("TransactionUpdater", fields: [workspaceId, updatedBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  account              FinancialAccount              @relation("SourceAccount", fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  destinationAccount   FinancialAccount?             @relation("DestinationAccount", fields: [workspaceId, destinationAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  category             Category?                     @relation(fields: [workspaceId, categoryId, type], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)
  sourceReceiptDraft   ReceiptDraft?                 @relation("ReceiptDraftTransaction")
  recurringTemplate    RecurringTransactionTemplate? @relation(fields: [workspaceId, recurringTemplateId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, createdBy, idempotencyKey])
  @@unique([workspaceId, recurringTemplateId, recurringDueDate])
  @@index([workspaceId, transactionDate, id])
  @@index([workspaceId, categoryId, transactionDate])
  @@index([workspaceId, accountId, transactionDate])
  @@index([workspaceId, destinationAccountId, transactionDate])
  @@map("transactions")
  @@schema("app")
}

// A recurring template is only a reminder. It changes financial totals only
// after an authorized member explicitly posts a due occurrence.
model RecurringTransactionTemplate {
  id                String                      @id @default(uuid()) @db.Uuid
  workspaceId       String                      @map("workspace_id") @db.Uuid
  createdBy         String                      @map("created_by") @db.Uuid
  name              String                      @db.VarChar(100)
  type              TransactionType
  amount            BigInt
  accountId         String                      @map("account_id") @db.Uuid
  categoryId        String                      @map("category_id") @db.Uuid
  note              String?                     @db.VarChar(1000)
  recurrenceDay     Int                         @map("recurrence_day") @db.SmallInt
  nextDueDate       DateTime                    @map("next_due_date") @db.Date
  archivedAt        DateTime?                   @map("archived_at") @db.Timestamptz(3)
  version           Int                         @default(1)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator           Membership                  @relation("RecurringTemplateCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  account           FinancialAccount            @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  category          Category                    @relation(fields: [workspaceId, categoryId, type], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)
  transactions      Transaction[]
  telegramReminders TelegramRecurringReminder[]

  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt, nextDueDate])
  @@index([workspaceId, accountId, archivedAt])
  @@index([workspaceId, categoryId, archivedAt])
  @@map("recurring_transaction_templates")
  @@schema("app")
}

model ReceiptDraft {
  id                       String             @id @default(uuid()) @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  createdBy                String             @map("created_by") @db.Uuid
  status                   ReceiptDraftStatus @default(needs_review)
  sourceKind               String             @default("fixture") @map("source_kind") @db.VarChar(30)
  extractedAmount          BigInt?            @map("extracted_amount")
  extractedTransactionDate DateTime?          @map("extracted_transaction_date") @db.Date
  extractedMerchant        String?            @map("extracted_merchant") @db.VarChar(200)
  extractedNote            String?            @map("extracted_note") @db.VarChar(1000)
  detectedInstitution      String?            @map("detected_institution") @db.VarChar(100)
  evidenceKind             String?            @map("evidence_kind") @db.VarChar(20)
  evidenceImage            Bytes?             @map("evidence_image") @db.ByteA
  evidenceImageMime        String?            @map("evidence_image_mime") @db.VarChar(50)
  evidenceImageExpiresAt   DateTime?          @map("evidence_image_expires_at") @db.Timestamptz(3)
  paymentRail              String?            @map("payment_rail") @db.VarChar(50)
  ocrConfidence            Int?               @map("ocr_confidence") @db.SmallInt
  institutionConfidence    Int?               @map("institution_confidence") @db.SmallInt
  suggestedCategoryId      String?            @map("suggested_category_id") @db.Uuid
  amountConfidence         Int?               @map("amount_confidence") @db.SmallInt
  dateConfidence           Int?               @map("date_confidence") @db.SmallInt
  merchantConfidence       Int?               @map("merchant_confidence") @db.SmallInt
  categoryConfidence       Int?               @map("category_confidence") @db.SmallInt
  correctedAmount          BigInt?            @map("corrected_amount")
  correctedTransactionDate DateTime?          @map("corrected_transaction_date") @db.Date
  correctedMerchant        String?            @map("corrected_merchant") @db.VarChar(200)
  correctedTitle           String?            @map("corrected_title") @db.VarChar(100)
  correctedNote            String?            @map("corrected_note") @db.VarChar(1000)
  selectedAccountId        String?            @map("selected_account_id") @db.Uuid
  selectedCategoryId       String?            @map("selected_category_id") @db.Uuid
  categoryType             TransactionType    @default(expense) @map("category_type")
  submittedTransactionId   String?            @map("submitted_transaction_id") @db.Uuid
  version                  Int                @default(1)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt              DateTime?          @map("submitted_at") @db.Timestamptz(3)
  cancelledAt              DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator                  Membership         @relation("ReceiptDraftCreator", fields: [workspaceId, createdBy], references: [workspaceId, userId], onDelete: Restrict, onUpdate: Restrict)
  suggestedCategory        Category?          @relation("ReceiptDraftSuggestedCategory", fields: [workspaceId, suggestedCategoryId, categoryType], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)
  selectedCategory         Category?          @relation("ReceiptDraftSelectedCategory", fields: [workspaceId, selectedCategoryId, categoryType], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)
  selectedAccount          FinancialAccount?  @relation("ReceiptDraftAccount", fields: [workspaceId, selectedAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  submittedTransaction     Transaction?       @relation("ReceiptDraftTransaction", fields: [workspaceId, submittedTransactionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, submittedTransactionId])
  @@index([workspaceId, createdBy, status, createdAt])
  @@map("receipt_drafts")
  @@schema("app")
}

model BudgetPeriod {
  id                  String       @id @default(uuid()) @db.Uuid
  workspaceId         String       @map("workspace_id") @db.Uuid
  startDate           DateTime     @map("start_date") @db.Date
  endDateExclusive    DateTime     @map("end_date_exclusive") @db.Date
  cycleSettingVersion Int          @default(1) @map("cycle_setting_version")
  isTransition        Boolean      @default(false) @map("is_transition")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycleSetting        CycleSetting @relation(fields: [workspaceId, cycleSettingVersion], references: [workspaceId, version], onDelete: Restrict, onUpdate: Restrict)
  budgets             Budget[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, startDate])
  @@map("budget_periods")
  @@schema("app")
}

model Budget {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  categoryId     String                @map("category_id") @db.Uuid
  categoryType   TransactionType       @default(expense) @map("category_type")
  periodId       String                @map("period_id") @db.Uuid
  limitAmount    BigInt                @map("limit_amount")
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  category       Category              @relation(fields: [workspaceId, categoryId, categoryType], references: [workspaceId, id, type], onDelete: Restrict, onUpdate: Restrict)
  period         BudgetPeriod          @relation(fields: [workspaceId, periodId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  telegramAlerts TelegramBudgetAlert[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, categoryId, periodId])
  @@index([workspaceId, periodId])
  @@map("budgets")
  @@schema("app")
}

model AuditEvent {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  entityType    String    @map("entity_type") @db.VarChar(50)
  entityId      String    @map("entity_id") @db.Uuid
  action        String    @db.VarChar(50)
  // Field names only, never free-text notes, credentials or complete payloads.
  changedFields String[]  @map("changed_fields")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, occurredAt, id])
  @@map("audit_events")
  @@schema("app")
}
