{
  "name": "alokasi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/sync-ocr-assets.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node scripts/db-check.mjs",
    "db:check:runtime": "node scripts/db-check.mjs --runtime",
    "db:check:test": "node scripts/db-check.mjs --test",
    "db:setup:runtime": "node scripts/db-setup-runtime.mjs",
    "auth:check": "node scripts/auth-check.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:test": "node scripts/db-migrate.mjs --test",
    "db:status": "node scripts/db-migrate.mjs --status",
    "db:status:test": "node scripts/db-migrate.mjs --test --status",
    "test:db": "vitest run --config vitest.config.mts",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:db:development": "node scripts/test-db-development.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@next/env": "16.3.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
